<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MultiMon.Core\MultiMon.Core.csproj" />
    <ProjectReference Include="..\MultiMon.Hap\MultiMon.Hap.csproj" />
    <ProjectReference Include="..\MultiMon.Platform.Mac\MultiMon.Platform.Mac.csproj" />
    <ProjectReference Include="..\MultiMon.Graphics.Mac\MultiMon.Graphics.Mac.csproj" />
    <ProjectReference Include="..\MultiMon.Decode.Mac\MultiMon.Decode.Mac.csproj" />
    <ProjectReference Include="..\MultiMon.Audio.Mac\MultiMon.Audio.Mac.csproj" />
    <ProjectReference Include="..\MultiMon.Control.Mac\MultiMon.Control.Mac.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.fiavaion.multimon.stress</ApplicationId>
    <TargetFramework>net9.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <!-- Workload 26.5 pins Xcode 26.5; the installed Xcode is newer (26.6). Newer is safe; the check is major.minor equality. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- MultiMon.Control.Mac is an app (its own bundle); referencing it for PerformanceController drags its
       runtimeconfig.json into THIS bundle's publish set, which the Mac SDK cannot classify. Drop that one file —
       the harness bundle carries its own runtimeconfig. -->
  <Target Name="DropReferencedAppRuntimeConfig" BeforeTargets="_ComputePublishLocation">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'MultiMon.Control.Mac.runtimeconfig.json'" />
    </ItemGroup>
  </Target>

</Project>
