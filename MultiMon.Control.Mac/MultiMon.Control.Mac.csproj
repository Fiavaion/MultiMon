<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.fiavaion.multimon.control</ApplicationId>
    <TargetFramework>net9.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <!-- Workload 26.5 pins Xcode 26.5; the installed Xcode is newer (26.6). Newer is safe; the check is major.minor equality. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- AVLN3001: MainWindow and ConvertToHapWindow take their view-model/log through the constructor
         (the composition root builds them), so they have no parameterless one for Avalonia's runtime XAML
         loader. Nothing loads them that way — adding an unused ctor just to silence this would be dead code. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon: Ident/icons/MultiMon.icns becomes the bundle's CFBundleIconFile (docs/MAC_PORT.md). -->
    <BundleResource Include="..\Ident\icons\MultiMon.icns" Link="MultiMon.icns" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiMon.Core\MultiMon.Core.csproj" />
    <ProjectReference Include="..\MultiMon.Platform.Mac\MultiMon.Platform.Mac.csproj" />
    <ProjectReference Include="..\MultiMon.Control.Mac.Core\MultiMon.Control.Mac.Core.csproj" />
    <ProjectReference Include="..\MultiMon.Control.Shared\MultiMon.Control.Shared.csproj" />
  </ItemGroup>
</Project>
