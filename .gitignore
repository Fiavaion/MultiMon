## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# Visual Studio cache files
*.cache
project.lock.json
project.fragment.lock.json
artifacts/

# VS Code
.vscode/

# Rider
.idea/

# User-specific files
*.suo
*.user
*.sln.docstates

# Temporary files
*.tmp
*.temp
*.log

# MultiMon: on-disk archives kept for reference, never committed (recoverable from git history too)
Old/
MultiMon-Distribution.zip
MultiMon-Distribution/

# Release kit output — never committed (reproducible via scripts/publish-release.ps1)
dist/

# dotnet publish output (ad-hoc runs)
**/[Pp]ublish/

# Claude Code machine-local config (absolute paths / permissions — never public)
.claude/settings.local.json

# Internal pre-launch marketing drafts (kept local; not for the public repo)
notes/launch-campaign.md
notes/launch-copy-drafts.md

# OS cruft
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# Coverage
*.coverage
*.coveragexml

# Claude Code agent worktrees
.claude/worktrees/
