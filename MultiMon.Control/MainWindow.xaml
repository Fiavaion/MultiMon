<Window x:Class="MultiMon.Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiMon.Control"
        mc:Ignorable="d"
        Title="MultiMon (rebuild) — Control Panel" Height="660" Width="1180"
        MinHeight="620" MinWidth="1100"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="36" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MULTI-MONITOR VIDEO CONSOLE" Style="{StaticResource EyebrowText}"
                               Foreground="{StaticResource CyanBrush}"/>
                    <TextBlock Text="MultiMon" Style="{StaticResource TitleText}" Margin="-1,1,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ReportBugButton" Content="Report a bug ↗" Click="ReportBug_Click"
                        Margin="0,0,18,0" Padding="10,4" VerticalAlignment="Center"
                        ToolTip="Report a bug on GitHub (opens the MultiMon issue tracker)."/>
                <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#2DE2E6" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="SIGNAL READY" Style="{StaticResource EyebrowText}"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="GpuText" Grid.Row="1" Style="{StaticResource HintText}" Margin="2,0,0,14"/>

        <!-- Mode + audio device -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="MODE" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
            <ComboBox x:Name="ModeCombo" Width="150" ItemsSource="{Binding Modes}"
                      SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding CanEdit}"/>
            <TextBlock Text="AUDIO DEVICE" Style="{StaticResource FieldLabel}" Margin="22,0,8,0"/>
            <ComboBox x:Name="AudioCombo" Width="280" ItemsSource="{Binding AudioDevices}"
                      SelectedItem="{Binding SelectedAudioDevice}" DisplayMemberPath="Name" IsEnabled="{Binding CanEdit}"/>
            <CheckBox Content="Sync (frame-lock same-length clips)" Foreground="#C0C0C0" VerticalAlignment="Center"
                      Margin="20,0,0,0" IsChecked="{Binding SyncIndividual}" IsEnabled="{Binding CanEdit}"
                      Visibility="{Binding SyncToggleVisible, Converter={StaticResource BoolToVis}}"/>
            <Button x:Name="IdentifyButton" Content="Identify screens" Margin="24,0,0,0"
                    Click="Identify_Click" IsEnabled="{Binding CanEdit}"
                    ToolTip="Show a big number on each monitor (click an overlay to dismiss)."/>
        </StackPanel>

        <!-- Assignments (left) + audio mixer (right) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="SOURCE VIDEO" Margin="0,0,10,0">
                <Grid>
                    <!-- Individual / Hap: one clip per monitor -->
                    <DataGrid x:Name="AssignGrid" CanUserAddRows="False"
                              IsEnabled="{Binding CanEdit}"
                              ItemsSource="{Binding Rows}"
                              Visibility="{Binding IsMultiSourceMode, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Monitor" Width="2*" IsReadOnly="True"
                                                Binding="{Binding DisplayName}"/>
                            <DataGridTextColumn Header="Video file" Width="4*"
                                                Binding="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Browse…" Padding="8,2" Margin="2" Click="BrowseRow_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Span / Split: ONE source shown across all monitors -->
                    <StackPanel VerticalAlignment="Top" Margin="2,6,2,2"
                                Visibility="{Binding IsSingleSourceMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="One clip shown across all monitors" Style="{StaticResource EyebrowText}"
                                   Foreground="{StaticResource CyanBrush}" Margin="2,0,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0"
                                    Click="BrowseSpan_Click" IsEnabled="{Binding CanEdit}"/>
                            <TextBox Text="{Binding SpanSourcePath, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}"/>
                        </DockPanel>

                        <!-- Split grid: auto by screen count, or a manual rows × columns override -->
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Split grid" Style="{StaticResource EyebrowText}"
                                       Foreground="{StaticResource CyanBrush}" Margin="2,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Auto (by screens)" VerticalAlignment="Center"
                                          IsChecked="{Binding SplitAuto}" IsEnabled="{Binding CanEdit}"/>
                                <TextBlock Text="Rows" VerticalAlignment="Center" Margin="18,0,4,0"/>
                                <TextBox Width="42" Text="{Binding SplitRows, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding SplitGridEditable}"/>
                                <TextBlock Text="×   Cols" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                <TextBox Width="42" Text="{Binding SplitColumns, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding SplitGridEditable}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="AUDIO MIXER">
                <DockPanel>
                    <!-- Master + add -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,4,8">
                        <TextBlock Text="MASTER" Style="{StaticResource FieldLabel}" Width="54" VerticalAlignment="Center"/>
                        <Slider Width="120" Minimum="0" Maximum="1" Value="{Binding MasterVolume}" VerticalAlignment="Center"/>
                        <CheckBox Content="Mute" VerticalAlignment="Center" Margin="10,0,0,0"
                                  IsChecked="{Binding MasterMuted}"/>
                        <Button Content="Add audio…" Margin="16,0,0,0" Click="AddAudio_Click"
                                IsEnabled="{Binding CanEdit}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AudioTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RaisedBrush}" CornerRadius="6" Margin="0,3" Padding="9,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" Width="110"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Text="VOL" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                                            <Slider Width="80" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center"/>
                                            <ToggleButton Content="M" Width="26" Height="22" Margin="6,0,0,0" IsChecked="{Binding Muted}"
                                                          ToolTip="Mute"/>
                                            <ToggleButton Content="S" Width="26" Height="22" Margin="3,0,0,0" IsChecked="{Binding Solo}"
                                                          ToolTip="Solo"/>
                                            <TextBlock Text="PAN" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                            <Slider Width="60" Minimum="-1" Maximum="1" Value="{Binding Pan}" VerticalAlignment="Center"/>
                                            <Button Content="✕" Width="24" Height="22" Margin="6,0,0,0" Click="RemoveAudio_Click"
                                                    Style="{StaticResource IconButton}" ToolTip="Remove track"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- Transport + project -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,10">
            <Button x:Name="PerformButton" Content="PERFORM" Width="124" Height="34" Margin="0,0,10,0"
                    Style="{StaticResource AccentButton}" Click="Perform_Click" IsEnabled="{Binding CanEdit}"/>
            <Button x:Name="StopButton" Content="Stop" Width="90" Height="34" Margin="0,0,24,0"
                    Click="Stop_Click" IsEnabled="{Binding IsPerforming}"/>
            <Button Content="New" Width="64" Height="34" Margin="0,0,8,0" Click="New_Click"/>
            <Button Content="Open project…" Width="124" Height="34" Margin="0,0,8,0" Click="Open_Click"/>
            <Button Content="Save project…" Width="124" Height="34" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Convert to HAP…" Width="130" Height="34" Click="ConvertHap_Click"/>
            <TextBlock Text="F11 perform/exit  ·  Esc exit  ·  Space pause/resume" Style="{StaticResource HintText}"
                       VerticalAlignment="Center" Margin="22,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{Binding Status}" Style="{StaticResource TelemetryText}"/>
    </Grid>
</Window>
